# Local development only. Real values belong in an ignored .env or server environment.
# Wallet-first SubSense is Mainnet only. Never put secrets in VITE_* variables.
SUBSENSE_NETWORK=mainnet
# Exact public origin for login/CSRF checks. HTTPS is required outside localhost.
SUBSENSE_PUBLIC_ORIGIN=http://localhost:3000
# Optional server-only diagnostic credentials. These are NOT used by wallet sessions.
# Users enter their own Mainnet credentials in the encrypted Connections vault.
TATUM_API_KEY=
# Optional Mainnet diagnostic MemWal account and delegate, never an owner wallet key.
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
