    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "^18.0.9",
    "express": "^4.21.0",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^7.0.0",
    "vite": "5.4.21"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
