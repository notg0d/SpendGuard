{
  "name": "subsense",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "setup:mainnet": "node scripts/setup-mainnet.mjs",
    "test:connections": "node scripts/test-connections.mjs",
    "diagnose:walrus": "node scripts/diagnose-walrus.mjs",
    "start": "node server/index.mjs --production",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
